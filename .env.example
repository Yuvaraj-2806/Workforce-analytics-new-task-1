# ============================================================
# Workforce Analytics Platform – Environment Configuration Template
# Copy this file to .env and configure your production secrets
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Configuration (Generate secure 64-character random hex strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_64_chars_long_hex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_64_chars_long_hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=WFA-Auth
JWT_AUDIENCE=WFA-Client

# MFA Secret Encryption Key (Must be 32 bytes in hex, e.g., crypto.randomBytes(32).toString('hex'))
MFA_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_for_aes_256_gcm
MFA_ISSUER=WFA Platform

# Security Parameters
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_EXPIRY_DAYS=7

# Rate Limiting Configuration
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
